#!/bin/sh
first_line=$(sed -n '1p' "$1")
if ! printf '%s\n' "$first_line" | grep -Eq '^(feat|fix|docs|chore|refactor|merge|test|ci|build|perf|style)(\([^()]+\))?(!)?: .+'; then
    echo 'ERROR: commit message must follow Conventional Commits.' >&2
    echo 'Expected: feat: description / fix: description / docs: description' >&2
    exit 1
fi
